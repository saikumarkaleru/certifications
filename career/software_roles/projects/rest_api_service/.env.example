# Copy to .env and adjust for your environment.

# General
APP_NAME="Task Manager API"
ENVIRONMENT=development
DEBUG=true

# Database (SQLite by default; swap for Postgres in production)
DATABASE_URL=sqlite:///./tasks.db

# JWT auth — MUST be overridden in production with a long random string
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
