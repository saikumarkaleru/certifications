# Copy to .env and fill in only what you need. NONE of these are required for
# the default offline demo (MockLLM + TF-IDF).

# Which LLM provider to use: mock (default) | openai | anthropic
LLM_PROVIDER=mock

# Which retriever backend the API uses: tfidf (default) | embedding
RAG_BACKEND=tfidf

# Required only if LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Required only if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
