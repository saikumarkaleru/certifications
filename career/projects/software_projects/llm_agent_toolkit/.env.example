# Copy to .env and fill in only what you need. The default (mock) needs NONE.

# Which provider the agent uses: mock (default, offline) | openai | anthropic
LLM_PROVIDER=mock

# --- OpenAI (only if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (only if LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
